{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "examples/<lesson>/<example>/example.json",
  "type": "object",
  "required": ["slug", "lessons", "since", "sameOutput"],
  "additionalProperties": false,
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "lines": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "properties": {
    "$schema": { "type": "string" },
    "slug": { "$ref": "#/$defs/slug", "description": "The folder name. Never changes after release." },
    "lessons": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
    "since": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+$" },
    "languages": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" },
      "description": "Only when the example leaves out a course language. Default: every language in repo.json."
    },
    "sources": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9]*$" },
      "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1 } }
    },
    "sameOutput": { "type": "boolean", "description": "true: one expected-output.txt for every language. false: each language folder has its own." },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9]*$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "bash": { "$ref": "#/$defs/lines" },
              "powershell": { "$ref": "#/$defs/lines" }
            }
          }
        }
      }
    }
  }
}
